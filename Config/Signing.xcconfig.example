// Copy this file to Config/Signing.local.xcconfig (git-ignored) and edit the values.
// The build scripts read plain "KEY = value" lines.

// Reverse-DNS identifier of the app. The helper becomes "<id>.helper".
// Releases refuse the com.example.* placeholder.
CLAMDOWN_BUNDLE_ID = app.clamdown

// Used by `scripts/build-app.sh release`.
// If two identities share a name, use the SHA-1 hash from `security find-identity -v -p codesigning`.
CLAMDOWN_SIGN_IDENTITY = Developer ID Application: Your Name (TEAMID)

// Used by `scripts/build-app.sh debug`.
CLAMDOWN_DEV_SIGN_IDENTITY = Apple Development: Your Name (TEAMID)

// Keychain profile created with `xcrun notarytool store-credentials`.
CLAMDOWN_NOTARY_PROFILE = clamdown-notary

// Sparkle EdDSA private key used by `scripts/make-appcast.sh` (base64 Ed25519 seed). Keep it out of the
// repository and back it up: without it, installed copies accept no further updates.
CLAMDOWN_SPARKLE_KEY_FILE = ~/.config/clamdown/sparkle-ed25519.key
